# Optional. Not required — the app's primary weather source (Open-Meteo) is
# free and keyless. Reserved if you extend the app with OpenWeatherMap as a
# secondary/status-check source.
OWM_API_KEY=

# Path to your GENUINE historical flood-events CSV.
# Required columns: date (YYYY-MM-DD), latitude, longitude
# Optional column: location_name
# Real sources: NDMA/NRSC India Flood Inventory, Dartmouth Flood Observatory,
# data.gov.in disaster-management datasets. See README.md.
HISTORICAL_FLOOD_CSV=data/historical_floods.csv

# Probability (%) at or above which an alert is raised on the Alerts page.
ALERT_THRESHOLD_PCT=60
